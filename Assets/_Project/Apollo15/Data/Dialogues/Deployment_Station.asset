  _dialogueId: Deployment_Station
  _title: ALSEP Central Station Deployment
  _lines:
  - _speaker: {fileID: 11400000, guid: 7c11a011d456488bb150d001da5e1501, type: 2}
    _portraitMood: Normal
    _customPortraitOverride: {fileID: 0}
    _text: 'ALSEP Central Station is on the regolith. RTG power is connected and the helical antenna is aligned with Earth.'
    _voiceClip: {fileID: 0}
    _charactersPerSecond: 45
    _autoAdvanceDelay: -1
    _onLineCompletedActions: []
  - _speaker: {fileID: 11400000, guid: 7c11a011d456488bb150d001da5e1502, type: 2}
    _portraitMood: Normal
    _customPortraitOverride: {fileID: 0}
    _text: 'Falcon, this is Houston. Central Station power telemetry is nominal. You are GO for science operations.'
    _voiceClip: {fileID: 8300000, guid: ad467307de834154c9db0fd952bc65f9, type: 3}
    _charactersPerSecond: 45
    _autoAdvanceDelay: -1
    _onLineCompletedActions: []
